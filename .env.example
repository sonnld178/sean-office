# SeanOffice — environment variables

# Server mode storage (S4) — Backblaze B2
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_ENDPOINT=

# AI (S6) — OpenRouter only
# OPENROUTER_API_KEY=

# Turnstile (S6 rate limit)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Gmail OAuth (S7, optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Supabase (S6 RAG, optional)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
